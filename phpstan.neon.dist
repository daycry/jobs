parameters:
  tmpDir: build/phpstan
  level: 6
  # Pin the analysis target to the project's minimum PHP version so the matrix
  # (8.2 / 8.3 / 8.4 / 8.5) all infer types identically. Without this, type
  # narrowing varies between runtimes (e.g. native readonly props, never-null
  # promoted constructor inference), producing false positives on some workers.
  phpVersion: 80200
  paths:
    - src/
    - tests/
  codeigniter:
    additionalConfigNamespaces:
      - Daycry\\Jobs\\Config
      - Daycry\\Jobs
  bootstrapFiles:
    - vendor/codeigniter4/framework/system/Test/bootstrap.php
  ignoreErrors:
    - '#Dynamic call to static method PHPUnit\\Framework\\Assert::#'
    - '#Parameter \#1 \$name of function config expects a valid class string, .+ given#'
    # config(FQCN::class) is valid CI4; the codeigniter ruleset only prefers the short string form.
    - '#Call to function config with .+ is discouraged#'
    # Pheanstalk is an optional dependency — classes may not be installed
    - '#unknown class Pheanstalk\\\\#'
    - '#class Pheanstalk\\\\#'
    - '#Instantiated class Pheanstalk\\\\#'
    - '#Class Pheanstalk\\\\#'
    # RedisHandler cannot be instantiated via new — it's a CI4 cache driver, ignore the direct instantiation check
    - '#Calling new RedisHandler\(\) directly is incomplete#'
    # model() discouraged but acceptable in legacy handler constructors
    - '#Call to function model with .+ is discouraged#'
    # CacheInterface declares increment(), but custom/injected cache handlers may omit it;
    # the runtime method_exists() guard is intentional (covered by RateLimiterTest fallbacks).
    - message: '#Call to function method_exists\(\) with CodeIgniter\\Cache\\CacheInterface and .increment. will always evaluate to true#'
      path: src/Libraries/RateLimiter.php
    # config('Jobs')/config('App')/config('Database') are typed nullable by the codeigniter
    # extension (the package config class collides with the 'Jobs' short name), but CI4 always
    # returns the object for a valid config. Property/method access on these is safe at runtime.
    - '#Cannot access property .+ on null\.#'
    # service('scheduler') is defined in a library service file that the codeigniter extension
    # cannot register, so getSharedInstance('scheduler') is typed null and the instanceof guard
    # reads as always-false. The runtime guard is still correct.
    - '#Call to unknown service method .scheduler.#'
    - message: '#Instanceof between null and Daycry\\Jobs\\Cron\\Scheduler will always evaluate to false#'
      path: src/Config/Services.php
    - '#Cannot call method .+ on null\.#'
    # CI4 TestCase::setPrivateProperty / injectMock accept mixed but PHPStan is strict
    - '#Parameter \#1 \$obj of method CodeIgniter\\\\Test\\\\CIUnitTestCase::setPrivateProperty\(\) expects object\|string, null given#'
    - '#Parameter \#2 \$mock of static method CodeIgniter\\\\Config\\\\BaseService::injectMock\(\) expects object, null given#'
    # Call to deprecated setAccessible() in PHP 8.1+ - test-only
    - '#Call to deprecated method setAccessible\(\)#'
    # PHPUnit assertions with always-true values in tests (valid pessimistic checks)
    - message: '#Call to method PHPUnit\\Framework\\Assert::assert.+ will always evaluate to true#'
      path: tests/*
    # Instanceof always true/false in tests
    - message: '#Instanceof between .+ will always evaluate to (true|false)#'
      path: tests/*
    # Test anonymous classes extending BaseCommand/BaseService don't need parent constructor
    - message: '#does not call parent constructor#'
      path: tests/*
    # Promoted array parameters in test stubs don't require full generic type annotations
    - message: '#has parameter .+ with no value type specified in iterable type array#'
      path: tests/*
    # Defensive `config(X::class) ?? new X()` fallbacks in tests: the codeigniter extension
    # narrows config() to non-null, so the fallback reads as a dead ?? — harmless in tests.
    - message: '#Expression on left side of \?\? is not nullable#'
      path: tests/*
    # Tests decode queue payloads as stdClass and read properties off the array|object union.
    - message: '#Cannot access property \$[a-zA-Z_]+ on array<mixed>\|object#'
      path: tests/*
    # Test support command stubs mirror CI4 BaseCommand untyped $aliases property.
    - message: '#Property .+::\$aliases has no type specified#'
      path: tests/*
  reportUnmatchedIgnoredErrors: false
  universalObjectCratesClasses:
    - CodeIgniter\Entity
    - CodeIgniter\Entity\Entity
    - Faker\Generator
  scanDirectories:
    - vendor/codeigniter4/framework/system/Helpers
  dynamicConstantNames:
    - APP_NAMESPACE
    - CI_DEBUG
    - ENVIRONMENT